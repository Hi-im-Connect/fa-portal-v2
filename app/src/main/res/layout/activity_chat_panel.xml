<?xml version="1.0" encoding="utf-8"?>
<!-- The bubble's chat panel (Messenger style): header, conversation, Pause/Stop while running, message box. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chat_scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:fitsSystemWindows="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

<!-- Messenger's top row: "+" for a new task, then the bubble (it springs onto head_slot) -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:gravity="end|center_vertical"
    android:orientation="horizontal"
    android:paddingEnd="12dp">

    <ImageButton
        android:id="@+id/chat_new"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/fa_new_bg"
        android:contentDescription="New task"
        android:elevation="6dp"
        android:src="@drawable/fa_ic_plus" />

    <View
        android:id="@+id/head_slot"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="14dp" />
</LinearLayout>

<ImageView
    android:id="@+id/chat_pointer"
    android:layout_width="20dp"
    android:layout_height="10dp"
    android:layout_gravity="end"
    android:layout_marginEnd="32dp"
    android:contentDescription="@null"
    android:src="@drawable/fa_pointer" />

<!-- the card: under the bubble, down to just above the keyboard -->
<LinearLayout
    android:id="@+id/chat_root"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:layout_marginHorizontal="8dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/fa_chat_bg"
    android:clickable="true"
    android:focusable="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageView
            android:id="@+id/chat_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:src="@drawable/logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/geist_sans"
                android:text="FastAutomate"
                android:textColor="@color/mobilerun_foreground"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chat_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/geist_sans"
                android:text="Ready"
                android:textColor="@color/mobilerun_muted_foreground"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/fa_input_line" />

    <ScrollView
        android:id="@+id/chat_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/chat_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="vertical"
            android:padding="12dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/chat_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chat_pause"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Resume"
            android:textAllCaps="false"
            android:textColor="@color/mobilerun_foreground"
            app:cornerRadius="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chat_stop"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Stop"
            android:textAllCaps="false"
            android:textColor="@color/fa_off"
            app:cornerRadius="20dp"
            app:strokeColor="@color/fa_off" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <EditText
            android:id="@+id/chat_input"
            android:textCursorDrawable="@drawable/fa_cursor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/fa_chat_input_bg"
            android:fontFamily="@font/geist_sans"
            android:hint="Tell me what to do..."
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:paddingHorizontal="18dp"
            android:paddingVertical="12dp"
            android:textColor="@color/mobilerun_foreground"
            android:textColorHint="@color/mobilerun_muted_foreground"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/chat_send"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/fa_send_bg"
            android:contentDescription="Send"
            android:src="@drawable/fa_ic_send" />
    </LinearLayout>
</LinearLayout>
</LinearLayout>
</FrameLayout>
