    <color name="mobilerun_destructive">#E06A5F</color>            <!-- oklch(0.55 0.18 28)    -->
    <color name="mobilerun_destructive_foreground">#0F1512</color> <!-- oklch(0.95 0.005 85)   -->

    <!-- Structural -->
    <color name="mobilerun_border">#26302A</color>                 <!-- oklch(0.25 0.006 60)   -->
    <color name="mobilerun_input">#111814</color>                  <!-- oklch(0.23 0.006 60)   -->
    <color name="mobilerun_ring">#2FB56F</color>                   <!-- oklch(0.72 0.16 265)   -->

