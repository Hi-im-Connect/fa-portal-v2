<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Mobilerun design tokens - DARK overrides.
        Same names as values/colors.xml; Android DayNight resolves between them.
    -->

    <!-- Surface tokens -->
    <color name="mobilerun_background">#0F1512</color>             <!-- oklch(0.16 0.006 60)   -->
    <color name="mobilerun_foreground">#E7EDE7</color>             <!-- oklch(0.92 0.005 85)   -->
