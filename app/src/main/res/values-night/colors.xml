    <color name="mobilerun_popover_foreground">#E7EDE7</color>     <!-- oklch(0.9  0.005 85)   -->

    <!-- Brand -->
    <color name="mobilerun_primary">#2FB56F</color>                <!-- oklch(0.72 0.16 265)   -->
    <color name="mobilerun_primary_foreground">#0B100D</color>     <!-- oklch(0.18 0.02 268)   -->
    <color name="mobilerun_secondary">#1D2721</color>              <!-- oklch(0.22 0.006 60)   -->
    <color name="mobilerun_secondary_foreground">#E7EDE7</color>   <!-- oklch(0.92 0.005 85)   -->

