<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="FaCard" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="cardBackgroundColor">@color/mobilerun_card</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/fa_input_line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="FaTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/geist_sans</item>
        <item name="android:textColor">@color/mobilerun_foreground</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FaMuted">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:fontFamily">@font/geist_sans</item>
        <item name="android:textColor">@color/mobilerun_muted_foreground</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>
